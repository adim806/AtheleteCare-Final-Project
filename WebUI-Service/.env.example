# Ollama chat model (browser-visible via Vite)
VITE_OLLAMA_MODEL=llama3

# Local Ollama base URL (Vite proxy target for /api/ollama)
OLLAMA_URL=http://127.0.0.1:11434

# Full n8n webhook URL (Vite proxies POST /api/triage here)
# Example cloud test URL:
# N8N_WEBHOOK_URL=https://YOUR_INSTANCE.app.n8n.cloud/webhook/athletecare-triage
N8N_WEBHOOK_URL=http://127.0.0.1:5678/webhook/athletecare-triage
