# Path to the local Llama.cpp GGUF model file
LLAMA_MODEL_PATH=models/llama-3-8b-instruct.gguf

# Llama 3 instruct chat template (do not change for llama-3-8b-instruct.gguf)
LLAMA_CHAT_FORMAT=llama-3

# Optional: override default directories
# DATA_DIR=data
# CHROMA_DIR=chroma_db
# MODELS_DIR=models

# Llama.cpp inference settings
# LLAMA_N_CTX=4096
# LLAMA_N_THREADS=4
# LLAMA_N_GPU_LAYERS=0
# LLAMA_TEMPERATURE=0.1
# LLAMA_MAX_TOKENS=512

# Insight validation
# INSIGHT_MIN_LENGTH=50
# LLM_GENERATION_MAX_RETRIES=1

# Retrieval pipeline
# RETRIEVER_FETCH_K=8
# FINAL_TOP_K=3
# ENABLE_METADATA_FILTERING=true
# ENABLE_RERANKING=true
# RERANK_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
