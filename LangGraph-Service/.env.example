# LangGraph Agent — AthleteCare Service 4
# Copy to .env and fill in values.

# Downstream tools (local defaults)
RAG_SERVICE_URL=http://127.0.0.1:8001
IMAGE_ANALYSER_URL=http://127.0.0.1:8002
HTTP_TIMEOUT_SEC=120

# LLM for planner + synthesiser
#   openai  — OpenAI Chat Completions (default)
#   heuristic — no API key; rule-based planner + template synthesis (demo/offline)
AGENT_LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional OpenAI-compatible base (Azure/OpenRouter/etc.)
# OPENAI_BASE_URL=
