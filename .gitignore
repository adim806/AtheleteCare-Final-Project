RAG-Service/.env

# Guardrails Service
Guardrails-Service/.venv/
Guardrails-Service/.venv311/
Guardrails-Service/.env

# Python
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/

# Local tunnel binaries (download separately)
tools/

# IDE
.vscode/
.idea/
